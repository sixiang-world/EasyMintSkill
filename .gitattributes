# 统一换行符为 LF，避免 Windows 与 *nix 之间反复重写全文差异
* text=auto eol=lf

# 二进制/无需文本处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary

# 明确按文本处理并保留 LF（HTML/JS 资产跨平台一致性）
*.md   text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf

# Shell 脚本必须是 LF——CRLF 会导致 *nix 下 "bad interpreter" 失败
*.sh    text eol=lf
*.bash  text eol=lf
sdd-workspace  text eol=lf
task-brief     text eol=lf
review-package text eol=lf
