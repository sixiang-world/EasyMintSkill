#!/usr/bin/env bash
# SessionStart 上下文注入器（平台中立版）
#
# 作用：把入口技能 using-easymint 的全文注入到会话启动时的上下文里，
#       让"先查 skill"这条规则在 Agent 看到用户消息之前就已经在它的上下文里。
#
# 为什么需要它：
#   技能包里的 SKILL.md 是**惰性文件** —— 放在磁盘上，不会自己生效。
#   如果没有这一层注入，using-easymint 和 kickoff 都得靠"模型自己想起来去查"，
#   而它们的存在意义恰恰是"强制触发"。注入器解决的就是这个自举问题。
#
# 用法：
#   ./session-start --format <shape> [--skills-dir <path>]
#
#   --format  必填。输出形状，取值见下表。不猜环境，由调用方显式指定。
#   --skills-dir  可选。技能包根目录，默认从脚本位置向上推两级。
#
# 输出形状：
#   nested   → {"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"..."}}
#              适用于消费嵌套 hookSpecificOutput 的运行时
#   snake    → {"additional_context":"..."}
#              适用于消费蛇形 additional_context 的运行时
#   sdk      → {"additionalContext":"..."}
#              适用于消费顶层 additionalContext 的 SDK 标准形状
#
# 注意：某些运行时会**同时**读取嵌套与顶层字段且不去重，
#       因此本脚本只输出你指定的那一种，绝不混发。
#
# 退出码：0 成功；1 参数错误；2 读取入口技能失败。

set -euo pipefail

FORMAT=""
SKILLS_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --format)
      FORMAT="${2:-}"
      shift 2
      ;;
    --skills-dir)
      SKILLS_DIR="${2:-}"
      shift 2
      ;;
    -h|--help)
      sed -n '2,30p' "$0"
      exit 0
      ;;
    *)
      printf '未知参数: %s\n' "$1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$FORMAT" ]]; then
  printf '缺少必填参数 --format（取值：nested | snake | sdk）\n' >&2
  exit 1
fi

case "$FORMAT" in
  nested|snake|sdk) ;;
  *)
    printf '不支持的 --format：%s（取值：nested | snake | sdk）\n' "$FORMAT" >&2
    exit 1
    ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [[ -z "$SKILLS_DIR" ]]; then
  # 默认假定本脚本位于 <包根>/integrations/ 下
  SKILLS_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

ENTRY_FILE="${SKILLS_DIR}/skills/using-easymint/SKILL.md"

if [[ ! -r "$ENTRY_FILE" ]]; then
  printf '读不到入口技能：%s\n请用 --skills-dir 指定技能包根目录。\n' "$ENTRY_FILE" >&2
  exit 2
fi

entry_content="$(cat "$ENTRY_FILE")"

# JSON 转义。用 bash 参数替换做单次 C 级扫描，比逐字符循环快几个数量级。
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

entry_escaped="$(escape_for_json "$entry_content")"

context="<EXTREMELY_IMPORTANT>\n本技能包已加载。\n\n**以下是入口技能 using-easymint 的完整内容 —— 它定义了'任何回应或动作前先查 skill'这条规则。创作性任务另经 kickoff 分类与批准。其余技能按名调用：**\n\n${entry_escaped}\n</EXTREMELY_IMPORTANT>"

# 用 printf 而非 heredoc —— 某些 bash 5.3+ 版本上 heredoc 会挂起。
case "$FORMAT" in
  nested)
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
    ;;
  snake)
    printf '{\n  "additional_context": "%s"\n}\n' "$context"
    ;;
  sdk)
    printf '{\n  "additionalContext": "%s"\n}\n' "$context"
    ;;
esac

exit 0
